package proxy:conversion;

// Runs the jobs of the imports component, which writes and reads the virtualized host's end of
// streams and futures, e.g. writing the body stream that a mock of the sync `consume-body`
// returns. Like the generated `conversion` interface of this package, the imports component
// exports it, for the exports component to call: its `start` function runs it. See
// `assets/executor.rs`.
interface executor {
  run: async func();
  stop: func();
  // Counts a step that isn't a run of the executor, e.g. the arrival of an export call, which the
  // exports component makes, and returns it (see `docs/p3-record-replay.md`, Steps).
  step: func() -> u32;
  // The last step.
  current-step: func() -> u32;
  // Waits until the executor's run in `step`, or returns at once if the count is already there:
  // `start` waits for the step before an export call's, which fuzz mode chooses, and replay's
  // trace has.
  wait-until-step: async func(step: u32);
  // Whether the exports component is dropping mocks of the imports component itself, e.g. those
  // it made for the borrowed arguments of an export call: the host's drops, not the guest's.
  host-drops: func(dropping: bool);
}
