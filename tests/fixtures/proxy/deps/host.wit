package test:host@0.1.0;

interface types {
  record point {
    x: s32,
    y: s32,
    label: option<string>,
  }
  // Acronym segments, which kebab-casing the Rust names would lose.
  variant shape {
    circle(u32),
    rect(point),
    HTTP-error(string),
    empty,
  }
  enum color {
    red,
    green,
    DNS-blue,
  }
  flags perms {
    read,
    write,
    exec,
  }
  resource counter {
    constructor(start: u32);
    get: func() -> u32;
    add: func(n: u32);
    merge: static func(a: borrow<counter>, b: counter) -> counter;
  }
  make-point: func(x: s32, y: s32) -> point;
  check: func(p: perms, c: color) -> result<shape, string>;
  open: func(name: string) -> result<counter, string>;
}
