package spike:record-component-host;
let host = new spike:host { ... };
let proxy = new spike:proxy { "spike:race/upstream": host["spike:race/host"], ... };
let guest = new spike:guest { "spike:race/host": proxy["spike:race/host"], ... };
let driver = new spike:driver {
  "spike:race/executor": proxy["spike:race/executor"],
  "spike:race/guest": guest["spike:race/guest"],
  ...
};
export driver...;
